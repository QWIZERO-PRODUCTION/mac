<Window x:Class="WinNotch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch" Width="480" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" Focusable="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI" SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Плоская круглая кнопка в стиле macOS: при наведении — лёгкая подсветка, при нажатии — «проседает» -->
        <Style x:Key="Ico" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="20" Width="50" Height="40"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.88" ScaleY="0.88"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Весь корпус: размеры анимируются из кода. Уши по бокам «сращивают» челку с краем экрана, как у MacBook -->
        <Grid x:Name="Notch" Width="180" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top"
              MouseEnter="Notch_MouseEnter" MouseLeave="Notch_MouseLeave" MouseWheel="Notch_MouseWheel">

            <Path Fill="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,0,0,0"
                  Data="M 0,0 L 10.5,0 L 10.5,10 L 10,10 A 10,10 0 0 0 0,0 Z"/>
            <Path Fill="Black" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-10,0"
                  Data="M 10.5,0 L 0,0 L 0,10 L 0.5,10 A 10,10 0 0 1 10.5,0 Z"/>

            <Border x:Name="Shell" Background="Black" CornerRadius="0,0,14,14" ClipToBounds="True">
                <Grid>
                    <!-- Свёрнутая челка: мини-обложка слева, эквалайзер справа -->
                    <Grid Height="32" VerticalAlignment="Top">
                        <Border x:Name="MiniArt" Width="18" Height="18" CornerRadius="5" HorizontalAlignment="Left"
                                Margin="16,0,0,0" Visibility="Collapsed" Background="#FF2C2C2E">
                            <Grid>
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#99FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border CornerRadius="5">
                                    <Border.Background>
                                        <ImageBrush x:Name="MiniArtBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="Eq" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,18,0" Visibility="Collapsed">
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#E6FFFFFF" Margin="0,0,2.5,0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Sc1" ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#E6FFFFFF" Margin="0,0,2.5,0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Sc2" ScaleY="0.5"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#E6FFFFFF" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Sc3" ScaleY="0.4"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                    </Grid>

                    <!-- Раскрытая часть -->
                    <Grid x:Name="Body" Margin="24,42,24,18" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">

                        <!-- Плеер -->
                        <Grid x:Name="MediaPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="64" Height="64" CornerRadius="12" Background="#FF1C1C1E">
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                                   Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border CornerRadius="12">
                                            <Border.Background>
                                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ArtistText" Foreground="#99FFFFFF" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TimeCur" Foreground="#80FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                <Border x:Name="Track" Grid.Column="1" Height="18" Background="Transparent" Cursor="Hand"
                                        MouseEnter="Track_Enter" MouseLeave="Track_Leave"
                                        MouseLeftButtonDown="Track_Down" MouseMove="Track_Move"
                                        MouseLeftButtonUp="Track_Up" LostMouseCapture="Track_Lost">
                                    <Grid x:Name="TrackLine" VerticalAlignment="Center" Height="4">
                                        <Border Background="#33FFFFFF" CornerRadius="4"/>
                                        <Border x:Name="Fill" Background="White" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TimeTotal" Grid.Column="2" Foreground="#80FFFFFF" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Button Style="{StaticResource Ico}" Click="Prev_Click">
                                    <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                                </Button>
                                <Button Style="{StaticResource Ico}" Click="Play_Click" Margin="6,0">
                                    <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="24"/>
                                </Button>
                                <Button Style="{StaticResource Ico}" Click="Next_Click">
                                    <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Время / дата / батарея, когда музыка не играет -->
                        <StackPanel x:Name="InfoPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                            <TextBlock x:Name="ClockText" FontSize="38" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DateText" FontSize="13" Foreground="#99FFFFFF" HorizontalAlignment="Center"/>
                            <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0">
                                <Grid Width="26" Height="12" VerticalAlignment="Center">
                                    <Border BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="3.5" Margin="0,0,2,0"/>
                                    <Border x:Name="BatFill" Background="White" CornerRadius="2" HorizontalAlignment="Left"
                                            Margin="2.5,2.5,0,2.5" Width="10"/>
                                    <Border Width="2" Height="5" Background="#80FFFFFF" HorizontalAlignment="Right" CornerRadius="0,1,1,0"/>
                                </Grid>
                                <TextBlock x:Name="BatteryText" FontSize="12" Foreground="#B3FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Уведомление (клик — закрыть) -->
                        <Grid x:Name="NotifPanel" Visibility="Collapsed" Background="Transparent"
                              MouseLeftButtonUp="Notif_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NotifBadge" Width="44" Height="44" CornerRadius="10" Background="#FF2C2C2E" VerticalAlignment="Top">
                                <Grid>
                                    <TextBlock x:Name="NotifInitial" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="NotifIcon" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock x:Name="NotifApp" FontSize="11" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NotifTitle" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NotifBody" FontSize="13" Foreground="#CCFFFFFF" TextWrapping="Wrap"
                                           LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
